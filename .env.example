# ============================================================================
# Document QA Assistant - 环境变量配置
# ============================================================================
# 复制此文件为 .env 并填入实际值
#   cp .env.example .env
#
# 默认使用阿里 DashScope（灵积），注册即送免费额度，够跑通整个项目：
#   https://dashscope.aliyun.com
# ============================================================================

# ---------------------------------------------------------------------------
# LLM 配置（必填）—— 默认使用 DashScope 免费模型
# ---------------------------------------------------------------------------

# 阿里灵积 API Key（在 https://dashscope.aliyun.com 右上角获取）
LLM_API_KEY=sk-your-dashscope-api-key-here

# DashScope 兼容 OpenAI 接口
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型选择：
#   qwen-max        经典模型，有免费额度，稳定可靠（推荐）
#   qwen3.7-max    旗舰模型，开通百炼后 90 天内享 100 万 Token 免费额度（推荐）
LLM_MODEL=qwen-max

# 生成参数
LLM_TEMPERATURE=0.0           # RAG 场景建议 0，确保答案基于文档
LLM_MAX_TOKENS=2048           # 单次最大输出 token
LLM_STREAM_TIMEOUT=60         # 流式生成超时秒数

# ---------------------------------------------------------------------------
# Embedding 配置 —— 默认使用 DashScope text-embedding-v4
# ---------------------------------------------------------------------------
EMBEDDING_BACKEND=api

# 嵌入 API Key（通常和 LLM 用同一个）
EMBEDDING_API_KEY=sk-your-dashscope-api-key-here

# DashScope 嵌入接口
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 嵌入模型选择：
#   text-embedding-v4  最新，1024维，中英文都好（推荐）
#   text-embedding-v3  768维，速度更快
#   text-embedding-v2  1536维
EMBEDDING_MODEL=text-embedding-v4

# 本地模式 (当 EMBEDDING_BACKEND=local 时生效，无视上方 API 配置)
# 推荐中文模型: BAAI/bge-small-zh-v1.5 (512维, 快速)
# 推荐英文模型: all-MiniLM-L6-v2 (384维, 快速)
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# 批处理大小
# 注意：DashScope text-embedding-v4 单次最多 10 条
#       OpenAI text-embedding-3-small 单次最多 2048 条
EMBEDDING_BATCH_SIZE=10

# ---------------------------------------------------------------------------
# ChromaDB 配置
# ---------------------------------------------------------------------------
# 持久化路径（相对项目根目录或绝对路径）
CHROMA_PERSIST_PATH=./data/chroma

# ---------------------------------------------------------------------------
# Neo4j 图数据库配置（可选：不启动也能用，语义记忆自动降级）
# ---------------------------------------------------------------------------
# Neo4j 连接信息
# 使用 Docker 启动: docker run -d -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:latest
# ⚠️ 生产/公网环境务必更换强密码，并同步修改下方的 NEO4J_PASSWORD
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# SQLite 配置
# ---------------------------------------------------------------------------
SQLITE_PATH=./data/metadata.db

# ---------------------------------------------------------------------------
# 检索参数
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=10              # 每次检索返回的分块数
MQE_NUM_VARIANTS=4              # MQE 生成几个查询变体
HYDE_WEIGHT=0.6                 # MQE+HyDE 中 HyDE 分支的权重
RRF_K=60                        # RRF 平滑常数

# ---------------------------------------------------------------------------
# 分块参数
# ---------------------------------------------------------------------------
CHUNK_SIZE=1024                 # 每个分块最大 token 数
CHUNK_OVERLAP=128               # 相邻分块重叠 token 数

# ---------------------------------------------------------------------------
# 应用设置
# ---------------------------------------------------------------------------
APP_NAME=Document QA Assistant
APP_PORT=7860
DEBUG=false
