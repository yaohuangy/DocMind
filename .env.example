# ============================================================================
# Document QA Assistant - 环境变量配置
# ============================================================================
# 复制此文件为 .env 并填入实际值
#   cp .env.example .env
#
# 默认使用阿里 DashScope（灵积），注册即送免费额度，够跑通整个项目：
#   https://dashscope.aliyun.com
# ============================================================================

# ---------------------------------------------------------------------------
# LLM 配置（必填）—— 默认使用 DashScope 免费模型
# ---------------------------------------------------------------------------

# 阿里灵积 API Key（在 https://dashscope.aliyun.com 右上角获取）
LLM_API_KEY=sk-your-dashscope-api-key-here

# DashScope 兼容 OpenAI 接口
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型选择：
#   qwen3.7-max     旗舰模型，开通百炼后 90 天内享 100 万 Token 免费额度
#   qwen3.7-plus    多模态输入，按量计费
#   qwen3.7-flash   高性价比，按量计费
LLM_MODEL=qwen3.7-max

# 生成参数
LLM_TEMPERATURE=0.0           # RAG 场景建议 0，确保答案基于文档
LLM_MAX_TOKENS=2048           # 单次最大输出 token
LLM_STREAM_TIMEOUT=60         # 流式生成超时秒数

# ---------------------------------------------------------------------------
# Embedding 配置 —— 默认使用 DashScope text-embedding-v4
# ---------------------------------------------------------------------------
EMBEDDING_BACKEND=api

# 嵌入 API Key（通常和 LLM 用同一个）
EMBEDDING_API_KEY=sk-your-dashscope-api-key-here

# DashScope 嵌入接口
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 嵌入模型选择：
#   text-embedding-v4  最新，1024维，中英文都好（推荐）
#   text-embedding-v3  768维，速度更快
#   text-embedding-v2  1536维
EMBEDDING_MODEL=text-embedding-v4

# 本地模式 (当 EMBEDDING_BACKEND=local 时生效，无视上方 API 配置)
# 推荐中文模型: BAAI/bge-small-zh-v1.5 (512维, 快速)
# 推荐英文模型: all-MiniLM-L6-v2 (384维, 快速)
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# 批处理大小
# 注意：DashScope text-embedding-v4 单次最多 10 条
#       OpenAI text-embedding-3-small 单次最多 2048 条
EMBEDDING_BATCH_SIZE=10

# ---------------------------------------------------------------------------
# ChromaDB 配置
# ---------------------------------------------------------------------------
# 持久化路径（相对项目根目录或绝对路径）
CHROMA_PERSIST_PATH=./data/chroma

# ---------------------------------------------------------------------------
# Neo4j 图数据库配置（可选：不启动也能用，语义记忆自动降级）
# ---------------------------------------------------------------------------
# Neo4j 连接信息
# 使用 Docker 启动: docker run -d -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:latest
# ⚠️ 生产/公网环境务必更换强密码，并同步修改下方的 NEO4J_PASSWORD
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# SQLite 配置
# ---------------------------------------------------------------------------
SQLITE_PATH=./data/metadata.db

# ---------------------------------------------------------------------------
# 检索参数
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=10              # 每次检索返回的分块数
MQE_NUM_VARIANTS=4              # MQE 生成几个查询变体
HYDE_WEIGHT=0.6                 # MQE+HyDE 中 HyDE 分支的权重
RRF_K=60                        # RRF 平滑常数

# ---------------------------------------------------------------------------
# 检索结果去重
# ---------------------------------------------------------------------------
RETRIEVAL_DEDUP=true            # 启用检索结果语义去重
RETRIEVAL_DEDUP_THRESHOLD=0.65  # bigram Jaccard 相似度阈值（0-1）

# ---------------------------------------------------------------------------
# 分块参数
# ---------------------------------------------------------------------------
# 全局默认值（对未在 chunk_presets 中单独配置的格式生效）
CHUNK_SIZE=512                  # 每个分块最大 token 数（tiktoken 精确计数）
CHUNK_OVERLAP=256               # 相邻分块重叠 token 数

# 按文档格式的自适应分块预设（代码内置，此处仅说明）：
#   pdf:  (1024, 256)  技术文档大分块，保证概念完整
#   pptx: (768,  192)  PPT 幻灯片，单页内容稀疏
#   web:  (768,  192)  网页正文，噪声过滤后中等密度
#   docx: (768,  192)  Word 文档
#   md:   (768,  192)  Markdown 按 ##/### 标题切分，该值仅用于超大段落回退
#   txt:  (768,  192)  纯文本
#   csv:  (384,  64)   表格数据，每行独立
#   xlsx: (384,  64)   电子表格

# ---------------------------------------------------------------------------
# 语义分块参数（SemanticSplitterNodeParser）
# ---------------------------------------------------------------------------
# 启用后非 Markdown 文档按句子嵌入相似度在话题边界处切分，
# 替代固定 token 数的 SentenceSplitter。需要 llama-index-embeddings-openai。
CHUNK_SEMANTIC=false               # 启用语义分块（true 开启）
CHUNK_SEMANTIC_BUFFER_SIZE=1       # 上下文窗口（1=逐句比较，更大=平滑）
CHUNK_SEMANTIC_BREAKPOINT_PERCENTILE=95  # 断点阈值（越小分块越多）
CHUNK_SEMANTIC_MAX_MULTIPLIER=2.0  # 语义块最大 token 倍数（超过回退 token 分块）
CHUNK_MIN_TOKENS=50                # 最小分块 token 数（低于此值合并到前一块）

# ---------------------------------------------------------------------------
# 应用设置
# ---------------------------------------------------------------------------
APP_NAME=Document QA Assistant
APP_PORT=7860
DEBUG=false

# ---------------------------------------------------------------------------
# MCP Client — 外部工具连接（可选）
# ---------------------------------------------------------------------------
# 启用 MCP Client 模式（DocMind 调用外部工具）
MCP_CLIENT_ENABLED=false

# Tavily 联网搜索（推荐，专为 AI Agent 设计，免费 1000 次/月）
# 注册: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
